<?xml version="1.0" encoding="utf-8"?>
<!-- A pure android.app.NativeActivity: the system dlopens the example's
     shared object and calls ANativeActivity_onCreate; there is no Java.
     configChanges keeps the activity alive across a rotation and the
     theme switch — the shell hears them as events. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:label="${appLabel}"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
